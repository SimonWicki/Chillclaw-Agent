# ChillClaw Agent
# Rename this file to .env

# Run mode: "dry" = no external side-effects, logs only
MODE=dry

# How often the agent runs a cycle
TICK_MS=6000

# Optional: where memory is stored
MEMORY_PATH=.memory/chillclaw.json

# Optional: basic identity
AGENT_NAME=ChillClaw

# Optional: if you later wire real integrations
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
